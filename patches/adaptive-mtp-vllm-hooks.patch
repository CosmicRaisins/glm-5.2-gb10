+            self._mtp_window_samples += len(samples)
+            for draft, accepted, context_tokens, output_tokens in samples:
+                self._mtp_window_draft_tokens += draft
+                self._mtp_window_accepted_tokens += accepted
+                self._mtp_window_output_tokens += output_tokens
+                self._mtp_window_context_min = context_tokens if self._mtp_window_context_min is None else min(self._mtp_window_context_min, context_tokens)
+                self._mtp_window_context_max = context_tokens if self._mtp_window_context_max is None else max(self._mtp_window_context_max, context_tokens)
+                for pos in range(1, len(self._mtp_position_survival) + 1):
+                    if draft >= pos:
+                        if pos == 1 or accepted >= pos - 1:
+                            self._mtp_position_eligible[pos - 1] += 1
+                        if accepted >= pos:
+                            self._mtp_position_survival[pos - 1] += 1
+        if self._mtp_window_steps < self.mtp_instrument_window:
+            return
