+def _parse_adaptive_spec_depth_ladder(
+    num_speculative_tokens: int,
+) -> list[int]:
+    raw = os.getenv("VLLM_ADAPTIVE_SPEC_DEPTHS", _ADAPTIVE_SPEC_DEPTHS_DEFAULT)
+    try:
+        depths = sorted({int(tok) for tok in raw.split(",") if tok.strip()})
+    except ValueError:
+        logger.warning(
+            "VLLM_ADAPTIVE_SPEC_DEPTHS=%r is not a comma-separated list of "
+            "ints; falling back to %r.",
+            raw,
+            _ADAPTIVE_SPEC_DEPTHS_DEFAULT,
+        )
+        depths = sorted(
+            {int(tok) for tok in _ADAPTIVE_SPEC_DEPTHS_DEFAULT.split(",")}
+        )
+    valid = [depth for depth in depths if 1 <= depth <= num_speculative_tokens]
+    if valid != depths:
+        logger.warning(
+            "VLLM_ADAPTIVE_SPEC_DEPTHS=%r: dropped out-of-range depths "
+            "(valid range [1, %d]); using %s.",
+            raw,
+            num_speculative_tokens,
+            valid,
+        )
+    return valid
+
