+        points = getattr(self, "adaptive_spec_snap_points", [candidate or self.num_spec_tokens])
+        snapped = max((depth for depth in points if candidate is not None and depth <= candidate), default=None)
+        record = {"schema": 1, "window_index": self._mtp_window_index, "configured_max_k": self.num_spec_tokens, "active_k": max((s[0] for s in samples), default=None), "controller_previous_k": getattr(update, "previous_num_spec_tokens", None), "controller_next_k": candidate, "raw_target_k": raw_target, "snapped_target_k": snapped, "decision_reason": getattr(update, "decision_reason", "fixed") if update is not None else "fixed", "controller_window": getattr(update, "observation_window", None), "tail_gain_23": getattr(update, "tail_gain_23", None), "position_4_gain": getattr(update, "position_4_gain", None), "verification_steps": self._mtp_window_steps, "draft_batches": self._mtp_window_samples, "drafts_attempted": drafted, "drafts_accepted": accepted, "mean_attempted_per_batch": drafted / self._mtp_window_samples if self._mtp_window_samples else 0.0, "mean_accepted_per_batch": accepted / self._mtp_window_samples if self._mtp_window_samples else 0.0, "acceptance_ratio": accepted / drafted if drafted else 0.0, "output_tokens_emitted": self._mtp_window_output_tokens, "window_elapsed_ms": (time.monotonic_ns() - self._mtp_window_started_ns) / 1e6 if self._mtp_window_started_ns else 0.0, "context_tokens_min": self._mtp_window_context_min, "context_tokens_max": self._mtp_window_context_max, "position_survival": [s / self._mtp_window_samples if self._mtp_window_samples else 0.0 for s in self._mtp_position_survival], "position_conditional_acceptance": [self._mtp_position_survival[i] / self._mtp_position_eligible[i] if self._mtp_position_eligible[i] else 0.0 for i in range(len(self._mtp_position_survival))]}
+        logger.info("MTP_WINDOW_JSON %s", json.dumps(record, sort_keys=True))
